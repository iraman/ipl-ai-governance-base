{
  "name": "ipl-ai-governance-base",
  "private": true,
  "description": "Trimble WorkRide plus AGL project base (dummy /src/ and versioned .ai-governance/ policies)",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "governance:validate": "node scripts/validate-governance.mjs",
    "governance:manifest": "node scripts/compute-behavior-manifest.mjs",
    "governance:test": "node scripts/governance-regression-tests.mjs",
    "skills:eval": "node scripts/skill-evaluator.mjs",
    "governance:check": "npm run governance:validate && npm run governance:test && npm run skills:eval",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "node --test test/backend/*.test.js",
    "test:frontend": "npx playwright test --config test/playwright.config.js"
  },
  "dependencies": {
    "express": "^4.21.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "supertest": "^7.1.4"
  }
}
